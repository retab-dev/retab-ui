      "default": null,
      "description": "Cardholder date of birth (YYYY-MM-DD).",
      "title": "Date Of Birth"
    },
    "issue_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
