      "default": null,
      "description": "Card issue date (YYYY-MM-DD).",
      "title": "Issue Date"
    },
    "expiration_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
