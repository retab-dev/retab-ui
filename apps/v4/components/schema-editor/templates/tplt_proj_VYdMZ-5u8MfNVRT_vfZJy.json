      "title": "Real Id"
    },
    "sex": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sex"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Cardholder sex as printed (M/F/X)."
