      "title": "Height"
    },
    "weight": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Weight as printed (unit varies by state).",
      "title": "Weight"
    },
    "eye_color": {
      "anyOf": [
        {
          "$ref": "#/$defs/EyeColor"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Eye color."
    },
    "hair_color": {
      "anyOf": [
        {
          "$ref": "#/$defs/HairColor"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Hair color."
    },
    "license_class": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
