      "description": "Issuing agency name (e.g., DMV, BMV, MVA).",
      "title": "Issuer Agency"
    },
    "name": {
      "anyOf": [
        {
          "$ref": "#/$defs/PersonName"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Cardholder name components."
    },
    "address": {
      "anyOf": [
        {
          "$ref": "#/$defs/Address"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Cardholder mailing/residential address."
    },
    "date_of_birth": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
