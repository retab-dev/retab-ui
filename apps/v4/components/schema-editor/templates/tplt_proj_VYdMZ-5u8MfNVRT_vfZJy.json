      "title": "Pdf417 Raw"
    },
    "face_image_url": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Reference to the portrait image, if extracted and stored.",
      "title": "Face Image Url"
    },
    "signature_image_url": {
      "anyOf": [
        {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Reference to the signature image, if extracted and stored.",
      "title": "Signature Image Url"
    }
