{
  "$defs": {
    "CompanyInfo": {
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of the company.",
          "title": "Name"
        },
        "tagline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Short tagline or slogan.",
          "title": "Tagline"
        },
        "website": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Company's website URL.",
          "title": "Website"
        },
        "hq_location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Headquarters location.",
          "title": "Hq Location"
        },
        "founded_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Year the company was founded.",
          "title": "Founded Year"
        }
      },
      "title": "CompanyInfo",
      "type": "object"
    },
    "Fundraising": {
      "properties": {
        "round_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoundType"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Type of funding round."
        },
        "amount_raising": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Amount the company is aiming to raise."
        },
        "amount_committed": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Amount already committed by investors."
        },
        "lead_investor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of the lead investor, if any.",
          "title": "Lead Investor"
        },
        "existing_investors": {
          "description": "List of existing investors.",
          "items": {
            "type": "string"
          },
          "title": "Existing Investors",
          "type": "array"
        }
      },
      "title": "Fundraising",
      "type": "object"
    },
    "Market": {
      "properties": {
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Market overview or key insights.",
          "title": "Summary"
        },
        "tam": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Total Addressable Market."
        },
        "sam": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Serviceable Addressable Market."
        },
        "som": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Serviceable Obtainable Market."
        }
      },
      "title": "Market",
      "type": "object"
    },
    "Money": {
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Numeric amount in the given currency.",
          "title": "Amount"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 4217 currency code, e.g., 'USD'.",
          "title": "Currency"
        }
      },
      "title": "Money",
      "type": "object"
    },
    "Problem": {
      "properties": {
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Summary of the problem being solved.",
          "title": "Summary"
        },
        "pains": {
          "description": "Specific pains or challenges faced by the target audience.",
          "items": {
            "type": "string"
          },
          "title": "Pains",
          "type": "array"
        }
      },
      "title": "Problem",
      "type": "object"
    },
    "RoundType": {
      "enum": [
        "pre-seed",
        "seed",
        "series-a",
        "series-b",
        "series-c+",
        "other"
      ],
      "title": "RoundType",
      "type": "string"
    },
    "Solution": {
      "properties": {
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Summary of the proposed solution.",
          "title": "Summary"
        },
        "key_features": {
          "description": "Main features or components of the solution.",
          "items": {
            "type": "string"
          },
          "title": "Key Features",
          "type": "array"
        }
      },
      "title": "Solution",
      "type": "object"
    },
    "Team": {
      "properties": {
        "members": {
          "description": "List of team members.",
          "items": {
            "$ref": "#/$defs/TeamMember"
          },
          "title": "Members",
          "type": "array"
        }
      },
      "title": "Team",
      "type": "object"
    },
    "TeamMember": {
      "properties": {
        "name": {
          "description": "Full name of the team member.",
          "title": "Name",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Role or position in the company.",
          "title": "Role"
        }
      },
      "required": ["name"],
      "title": "TeamMember",
      "type": "object"
    },
    "Traction": {
      "properties": {
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Summary of traction and growth.",
          "title": "Summary"
        },
        "customers_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Number of paying customers.",
          "title": "Customers Count"
        },
        "mrr": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Monthly Recurring Revenue."
        },
        "arr": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Annual Recurring Revenue."
        }
      },
      "title": "Traction",
      "type": "object"
    }
  },
  "properties": {
    "company": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompanyInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Basic company information."
    },
    "problem": {
      "anyOf": [
        {
          "$ref": "#/$defs/Problem"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Description of the problem being solved."
    },
    "solution": {
      "anyOf": [
        {
          "$ref": "#/$defs/Solution"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Description of the proposed solution."
    },
    "market": {
      "anyOf": [
        {
          "$ref": "#/$defs/Market"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Market information and size estimates."
    },
    "traction": {
      "anyOf": [
        {
          "$ref": "#/$defs/Traction"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Traction and growth indicators."
    },
    "team": {
      "anyOf": [
        {
          "$ref": "#/$defs/Team"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Information about the founding team and key members."
    },
    "fundraising": {
      "anyOf": [
        {
          "$ref": "#/$defs/Fundraising"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Fundraising details."
    }
  },
  "title": "PitchDeck",
  "type": "object"
}
