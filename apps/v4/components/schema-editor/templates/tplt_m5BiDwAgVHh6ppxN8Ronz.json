{
  "$defs": {
    "Assets": {
      "properties": {
        "current_assets": {
          "description": "Total current assets.",
          "title": "Current Assets",
          "type": "number"
        },
        "non_current_assets": {
          "description": "Total non-current assets.",
          "title": "Non Current Assets",
          "type": "number"
        }
      },
      "required": ["current_assets", "non_current_assets"],
      "title": "Assets",
      "type": "object"
    },
    "BalanceSheet": {
      "properties": {
        "assets": {
          "$ref": "#/$defs/Assets",
          "description": "Assets details."
        },
        "liabilities": {
          "$ref": "#/$defs/Liabilities",
          "description": "Liabilities details."
        },
        "equity": {
          "$ref": "#/$defs/Equity",
          "description": "Equity details."
        }
      },
      "required": ["assets", "liabilities", "equity"],
      "title": "BalanceSheet",
      "type": "object"
    },
    "Employee": {
      "properties": {
        "employee_id": {
          "description": "Unique identifier for the employee.",
          "title": "Employee Id",
          "type": "string"
        },
        "name": {
          "description": "Name of the employee.",
          "title": "Name",
          "type": "string"
        },
        "monthly_basic": {
          "description": "Monthly basic salary.",
          "title": "Monthly Basic",
          "type": "number"
        },
        "other_earnings": {
          "description": "Other earnings for the employee.",
          "title": "Other Earnings",
          "type": "number"
        },
        "gross_earnings": {
          "description": "Total gross earnings.",
          "title": "Gross Earnings",
          "type": "number"
        },
        "total_deductions": {
          "description": "Total deductions from the salary.",
          "title": "Total Deductions",
          "type": "number"
        },
        "net_salary": {
          "description": "Net salary after deductions.",
          "title": "Net Salary",
          "type": "number"
        },
        "total_contribution": {
          "description": "Total company contribution.",
          "title": "Total Contribution",
          "type": "number"
        },
        "total_cost_per_employee": {
          "description": "Total cost per employee.",
          "title": "Total Cost Per Employee",
          "type": "number"
        },
        "leave_due": {
          "description": "Leave due for the employee.",
          "title": "Leave Due",
          "type": "number"
        },
        "leave_taken": {
          "description": "Leave taken by the employee.",
          "title": "Leave Taken",
          "type": "number"
        }
      },
      "required": [
        "employee_id",
        "name",
        "monthly_basic",
        "other_earnings",
        "gross_earnings",
        "total_deductions",
        "net_salary",
        "total_contribution",
        "total_cost_per_employee",
        "leave_due",
        "leave_taken"
      ],
      "title": "Employee",
      "type": "object"
    },
    "Equity": {
      "properties": {
        "total_equity": {
          "description": "Total equity amount.",
          "title": "Total Equity",
          "type": "number"
        }
      },
      "required": ["total_equity"],
      "title": "Equity",
      "type": "object"
    },
    "Expenses": {
      "properties": {
        "total_expenses": {
          "description": "Total expenses amount.",
          "title": "Total Expenses",
          "type": "number"
        },
        "breakdown": {
          "description": "Breakdown of expenses.",
          "items": {
            "$ref": "#/$defs/ExpensesBreakdownItem"
          },
          "title": "Breakdown",
          "type": "array"
        }
      },
      "required": ["total_expenses", "breakdown"],
      "title": "Expenses",
      "type": "object"
    },
    "ExpensesBreakdownItem": {
      "properties": {
        "category": {
          "description": "Category of expense.",
          "title": "Category",
          "type": "string"
        },
        "amount": {
          "description": "Amount spent in this category.",
          "title": "Amount",
          "type": "number"
        }
      },
      "required": ["category", "amount"],
      "title": "ExpensesBreakdownItem",
      "type": "object"
    },
    "FinancialData": {
      "properties": {
        "income": {
          "$ref": "#/$defs/Income",
          "description": "Income details."
        },
        "expenses": {
          "$ref": "#/$defs/Expenses",
          "description": "Expenses details."
        }
      },
      "required": ["income", "expenses"],
      "title": "FinancialData",
      "type": "object"
    },
    "Income": {
      "properties": {
        "total_income": {
          "description": "Total income amount.",
          "title": "Total Income",
          "type": "number"
        },
        "breakdown": {
          "description": "Breakdown of income sources.",
          "items": {
            "$ref": "#/$defs/IncomeBreakdownItem"
          },
          "title": "Breakdown",
          "type": "array"
        }
      },
      "required": ["total_income", "breakdown"],
      "title": "Income",
      "type": "object"
    },
    "IncomeBreakdownItem": {
      "properties": {
        "source": {
          "description": "Source of income.",
          "title": "Source",
          "type": "string"
        },
        "amount": {
          "description": "Amount from this source.",
          "title": "Amount",
          "type": "number"
        }
      },
      "required": ["source", "amount"],
      "title": "IncomeBreakdownItem",
      "type": "object"
    },
    "Liabilities": {
      "properties": {
        "current_liabilities": {
          "description": "Total current liabilities.",
          "title": "Current Liabilities",
          "type": "number"
        },
        "non_current_liabilities": {
          "description": "Total non-current liabilities.",
          "title": "Non Current Liabilities",
          "type": "number"
        }
      },
      "required": ["current_liabilities", "non_current_liabilities"],
      "title": "Liabilities",
      "type": "object"
    },
    "PayrollReport": {
      "properties": {
        "employees": {
          "description": "List of employees and their payroll details.",
          "items": {
            "$ref": "#/$defs/Employee"
          },
          "title": "Employees",
          "type": "array"
        }
      },
      "required": ["employees"],
      "title": "PayrollReport",
      "type": "object"
    },
    "Recipient": {
      "properties": {
        "name": {
          "description": "The name of the recipient.",
          "title": "Name",
          "type": "string"
        },
        "contact_method": {
          "description": "The method of contact, e.g., email.",
          "title": "Contact Method",
          "type": "string"
        }
      },
      "required": ["name", "contact_method"],
      "title": "Recipient",
      "type": "object"
    },
    "ReportItem": {
      "properties": {
        "title": {
          "description": "The title of the report.",
          "title": "Title",
          "type": "string"
        },
        "description": {
          "description": "A brief description of the report.",
          "title": "Description",
          "type": "string"
        }
      },
      "required": ["title", "description"],
      "title": "ReportItem",
      "type": "object"
    }
  },
  "X-SchemaType": "generic",
  "additionalProperties": false,
  "properties": {
    "document_date": {
      "description": "The date of the document.",
      "title": "Document Date",
      "type": "string"
    },
    "recipient": {
      "$ref": "#/$defs/Recipient",
      "description": "Details of the recipient of the document."
    },
    "subject": {
      "description": "The subject of the document.",
      "title": "Subject",
      "type": "string"
    },
    "reports": {
      "description": "List of reports included in the document.",
      "items": {
        "$ref": "#/$defs/ReportItem"
      },
      "title": "Reports",
      "type": "array"
    },
    "financial_data": {
      "$ref": "#/$defs/FinancialData",
      "description": "Financial data extracted from the document."
    },
    "balance_sheet": {
      "$ref": "#/$defs/BalanceSheet",
      "description": "Balance sheet details."
    },
    "payroll_report": {
      "$ref": "#/$defs/PayrollReport",
      "description": "Payroll report details."
    }
  },
  "required": [
    "document_date",
    "recipient",
    "subject",
    "reports",
    "financial_data",
    "balance_sheet",
    "payroll_report"
  ],
  "title": "PropertyManagementReport",
  "type": "object"
}
