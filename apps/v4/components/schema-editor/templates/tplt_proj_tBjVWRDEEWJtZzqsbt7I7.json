{
  "$defs": {
    "Transaction": {
      "properties": {
        "transaction_type": {
          "$ref": "#/$defs/TransactionType",
          "description": "Type of transaction: deposit or withdrawal."
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Description of the transaction (e.g., 'ATM Withdrawal ...').",
          "title": "Description"
        },
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Date of the transaction.",
          "title": "Date"
        },
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Transaction amount in account currency.",
          "title": "Amount"
        },
        "additional_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An additional date provided in the statement, if any.",
          "title": "Additional Date"
        }
      },
      "required": ["transaction_type"],
      "title": "Transaction",
      "type": "object"
    },
    "TransactionType": {
      "enum": ["deposit", "withdrawal"],
      "title": "TransactionType",
      "type": "string"
    }
  },
  "properties": {
    "bank_name": {
      "anyOf": [
        {
          "type": "string",
          "title": "BankName"
        },
        {
          "type": "null"
        }
      ],
      "title": "BankName",
      "description": "Name of the bank issuing the statement."
    },
    "bank_address": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Address of the bank.",
      "title": "Bank Address"
    },
    "client_name": {
      "description": "Name of the account holder.",
      "title": "Client Name",
      "type": "string"
    },
    "account_number": {
      "description": "Bank account number.",
      "title": "Account Number",
      "type": "string"
    },
    "account_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Type of account (e.g., 'Checking', 'Savings').",
      "title": "Account Type"
    },
    "statement_date": {
      "description": "Date when the statement was issued.",
      "format": "date",
      "title": "Statement Date",
      "type": "string"
    },
    "statement_start_date": {
      "description": "Start date of the statement period.",
      "format": "date",
      "title": "Statement Start Date",
      "type": "string"
    },
    "statement_end_date": {
      "description": "End date of the statement period.",
      "format": "date",
      "title": "Statement End Date",
      "type": "string"
    },
    "starting_balance": {
      "description": "Balance at the start of the statement period.",
      "title": "Starting Balance",
      "type": "number"
    },
    "ending_balance": {
      "description": "Balance at the end of the statement period.",
      "title": "Ending Balance",
      "type": "number"
    },
    "transactions": {
      "description": "List of transactions recorded in the statement.",
      "items": {
        "$ref": "#/$defs/Transaction"
      },
      "title": "Transactions",
      "type": "array"
    }
  },
  "required": [
    "bank_name",
    "client_name",
    "account_number",
    "statement_date",
    "statement_start_date",
    "statement_end_date",
    "starting_balance",
    "ending_balance",
    "transactions"
  ],
  "title": "BankStatement",
  "type": "object"
}
