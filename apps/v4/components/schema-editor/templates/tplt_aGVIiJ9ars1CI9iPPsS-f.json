{
  "$defs": {
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "description": "The author(s) of the document.",
          "title": "Author",
          "type": "string"
        },
        "year": {
          "description": "The publication year of the document.",
          "title": "Year",
          "type": "integer"
        },
        "title": {
          "description": "The title of the document.",
          "title": "Title",
          "type": "string"
        },
        "publisher": {
          "description": "The publisher of the document.",
          "title": "Publisher",
          "type": "string"
        },
        "location": {
          "description": "The location of the publisher.",
          "title": "Location",
          "type": "string"
        },
        "editor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The editor(s) of the document, if applicable.",
          "title": "Editor"
        },
        "journal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The journal name, if applicable.",
          "title": "Journal"
        },
        "volume": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The volume number of the journal, if applicable.",
          "title": "Volume"
        },
        "issue": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The issue number of the journal, if applicable.",
          "title": "Issue"
        },
        "pages": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The page range of the document, if applicable.",
          "title": "Pages"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The DOI of the document, if applicable.",
          "title": "Doi"
        },
        "edition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The edition of the document, if applicable.",
          "title": "Edition"
        },
        "translator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The translator of the document, if applicable.",
          "title": "Translator"
        }
      },
      "required": ["author", "year", "title", "publisher", "location"],
      "title": "Reference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "references": {
      "description": "A list of references extracted from documents.",
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "title": "References",
      "type": "array"
    }
  },
  "required": ["references"],
  "title": "ReferenceList",
  "type": "object"
}
