{
  "$defs": {
    "Address": {
      "additionalProperties": false,
      "properties": {
        "street": {
          "description": "Street address.",
          "title": "Street",
          "type": "string"
        },
        "city": {
          "description": "City.",
          "title": "City",
          "type": "string"
        },
        "state": {
          "description": "State.",
          "title": "State",
          "type": "string"
        },
        "zip_code": {
          "description": "Zip code.",
          "title": "Zip Code",
          "type": "string"
        }
      },
      "required": ["street", "city", "state", "zip_code"],
      "title": "Address",
      "type": "object"
    },
    "BalanceSheet": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "$ref": "#/$defs/BalanceSheetAssets",
          "description": "Assets section of the balance sheet."
        },
        "liabilities": {
          "$ref": "#/$defs/BalanceSheetLiabilities",
          "description": "Liabilities section of the balance sheet."
        },
        "equity": {
          "$ref": "#/$defs/BalanceSheetEquity",
          "description": "Equity section of the balance sheet."
        }
      },
      "required": ["assets", "liabilities", "equity"],
      "title": "BalanceSheet",
      "type": "object"
    },
    "BalanceSheetAssets": {
      "additionalProperties": false,
      "properties": {
        "current_assets": {
          "description": "List of current assets.",
          "items": {
            "$ref": "#/$defs/NamedAmount"
          },
          "title": "Current Assets",
          "type": "array"
        },
        "non_current_assets": {
          "description": "List of non-current assets.",
          "items": {
            "$ref": "#/$defs/NamedAmount"
          },
          "title": "Non Current Assets",
          "type": "array"
        }
      },
      "required": ["current_assets", "non_current_assets"],
      "title": "BalanceSheetAssets",
      "type": "object"
    },
    "BalanceSheetEquity": {
      "additionalProperties": false,
      "properties": {
        "equity_components": {
          "description": "List of equity components.",
          "items": {
            "$ref": "#/$defs/BalanceSheetEquityComponent"
          },
          "title": "Equity Components",
          "type": "array"
        }
      },
      "required": ["equity_components"],
      "title": "BalanceSheetEquity",
      "type": "object"
    },
    "BalanceSheetEquityComponent": {
      "additionalProperties": false,
      "properties": {
        "component_name": {
          "description": "Name of the equity component.",
          "title": "Component Name",
          "type": "string"
        },
        "amount": {
          "description": "Amount of the equity component.",
          "title": "Amount",
          "type": "number"
        }
      },
      "required": ["component_name", "amount"],
      "title": "BalanceSheetEquityComponent",
      "type": "object"
    },
    "BalanceSheetLiabilities": {
      "additionalProperties": false,
      "properties": {
        "current_liabilities": {
          "description": "List of current liabilities.",
          "items": {
            "$ref": "#/$defs/NamedAmount"
          },
          "title": "Current Liabilities",
          "type": "array"
        },
        "non_current_liabilities": {
          "description": "List of non-current liabilities.",
          "items": {
            "$ref": "#/$defs/NamedAmount"
          },
          "title": "Non Current Liabilities",
          "type": "array"
        }
      },
      "required": ["current_liabilities", "non_current_liabilities"],
      "title": "BalanceSheetLiabilities",
      "type": "object"
    },
    "BusinessSection": {
      "additionalProperties": false,
      "properties": {
        "overview": {
          "description": "Overview of the company's business.",
          "title": "Overview",
          "type": "string"
        },
        "segment_information": {
          "description": "Information about the company's reportable segments.",
          "items": {
            "$ref": "#/$defs/Segment"
          },
          "title": "Segment Information",
          "type": "array"
        },
        "products_and_services": {
          "description": "List of products and services offered by the company.",
          "items": {
            "$ref": "#/$defs/ProductService"
          },
          "title": "Products And Services",
          "type": "array"
        }
      },
      "required": ["overview", "segment_information", "products_and_services"],
      "title": "BusinessSection",
      "type": "object"
    },
    "CashFlowStatement": {
      "additionalProperties": false,
      "properties": {
        "net_cash_from_operating_activities": {
          "description": "Net cash provided by operating activities.",
          "title": "Net Cash From Operating Activities",
          "type": "number"
        },
        "net_cash_used_in_investing_activities": {
          "description": "Net cash used in investing activities.",
          "title": "Net Cash Used In Investing Activities",
          "type": "number"
        },
        "net_cash_from_financing_activities": {
          "description": "Net cash provided by or used in financing activities.",
          "title": "Net Cash From Financing Activities",
          "type": "number"
        }
      },
      "required": [
        "net_cash_from_operating_activities",
        "net_cash_used_in_investing_activities",
        "net_cash_from_financing_activities"
      ],
      "title": "CashFlowStatement",
      "type": "object"
    },
    "FinancialStatements": {
      "additionalProperties": false,
      "properties": {
        "balance_sheet": {
          "$ref": "#/$defs/BalanceSheet",
          "description": "Balance sheet information."
        },
        "income_statement": {
          "$ref": "#/$defs/IncomeStatement",
          "description": "Income statement information."
        },
        "cash_flow_statement": {
          "$ref": "#/$defs/CashFlowStatement",
          "description": "Cash flow statement information."
        }
      },
      "required": ["balance_sheet", "income_statement", "cash_flow_statement"],
      "title": "FinancialStatements",
      "type": "object"
    },
    "Header": {
      "additionalProperties": false,
      "properties": {
        "form_type": {
          "description": "The form type of the filing, e.g., '10-K'.",
          "title": "Form Type",
          "type": "string"
        },
        "fiscal_year_end": {
          "description": "The fiscal year end date of the filing.",
          "title": "Fiscal Year End",
          "type": "string"
        },
        "commission_file_number": {
          "description": "The commission file number of the registrant.",
          "title": "Commission File Number",
          "type": "string"
        },
        "company_name": {
          "description": "The exact name of the registrant as specified in its charter.",
          "title": "Company Name",
          "type": "string"
        },
        "state_of_incorporation": {
          "description": "The state or other jurisdiction of incorporation or organization.",
          "title": "State Of Incorporation",
          "type": "string"
        },
        "irs_employer_identification_no": {
          "description": "The IRS Employer Identification Number.",
          "title": "Irs Employer Identification No",
          "type": "string"
        },
        "address": {
          "$ref": "#/$defs/Address",
          "description": "The address of the principal executive offices."
        },
        "telephone_number": {
          "description": "The registrant's telephone number, including area code.",
          "title": "Telephone Number",
          "type": "string"
        },
        "securities_registered": {
          "description": "Securities registered pursuant to Section 12(b) of the Act.",
          "items": {
            "$ref": "#/$defs/RegisteredSecurity"
          },
          "title": "Securities Registered",
          "type": "array"
        }
      },
      "required": [
        "form_type",
        "fiscal_year_end",
        "commission_file_number",
        "company_name",
        "state_of_incorporation",
        "irs_employer_identification_no",
        "address",
        "telephone_number",
        "securities_registered"
      ],
      "title": "Header",
      "type": "object"
    },
    "IncomeStatement": {
      "additionalProperties": false,
      "properties": {
        "revenues": {
          "description": "Total revenues.",
          "title": "Revenues",
          "type": "number"
        },
        "cost_of_revenues": {
          "description": "Total cost of revenues.",
          "title": "Cost Of Revenues",
          "type": "number"
        },
        "gross_profit": {
          "description": "Gross profit.",
          "title": "Gross Profit",
          "type": "number"
        },
        "operating_expenses": {
          "description": "Total operating expenses.",
          "title": "Operating Expenses",
          "type": "number"
        },
        "net_income": {
          "description": "Net income.",
          "title": "Net Income",
          "type": "number"
        }
      },
      "required": [
        "revenues",
        "cost_of_revenues",
        "gross_profit",
        "operating_expenses",
        "net_income"
      ],
      "title": "IncomeStatement",
      "type": "object"
    },
    "LegalProceeding": {
      "additionalProperties": false,
      "properties": {
        "case_name": {
          "description": "Name of the legal case.",
          "title": "Case Name",
          "type": "string"
        },
        "description": {
          "description": "Description of the legal case.",
          "title": "Description",
          "type": "string"
        }
      },
      "required": ["case_name", "description"],
      "title": "LegalProceeding",
      "type": "object"
    },
    "NamedAmount": {
      "additionalProperties": false,
      "properties": {
        "asset_name": {
          "description": "Name of the current asset.",
          "title": "Asset Name",
          "type": "string"
        },
        "amount": {
          "description": "Amount of the current asset.",
          "title": "Amount",
          "type": "number"
        }
      },
      "required": ["asset_name", "amount"],
      "title": "NamedAmount",
      "type": "object"
    },
    "ProductService": {
      "additionalProperties": false,
      "properties": {
        "product_name": {
          "description": "Name of the product or service.",
          "title": "Product Name",
          "type": "string"
        },
        "description": {
          "description": "Description of the product or service.",
          "title": "Description",
          "type": "string"
        }
      },
      "required": ["product_name", "description"],
      "title": "ProductService",
      "type": "object"
    },
    "RegisteredSecurity": {
      "additionalProperties": false,
      "properties": {
        "title_of_each_class": {
          "description": "Title of each class of securities.",
          "title": "Title Of Each Class",
          "type": "string"
        },
        "trading_symbol": {
          "description": "Trading symbol(s).",
          "title": "Trading Symbol",
          "type": "string"
        },
        "exchange_name": {
          "description": "Name of each exchange on which registered.",
          "title": "Exchange Name",
          "type": "string"
        }
      },
      "required": ["title_of_each_class", "trading_symbol", "exchange_name"],
      "title": "RegisteredSecurity",
      "type": "object"
    },
    "RiskFactor": {
      "additionalProperties": false,
      "properties": {
        "risk_title": {
          "description": "Title of the risk factor.",
          "title": "Risk Title",
          "type": "string"
        },
        "description": {
          "description": "Description of the risk factor.",
          "title": "Description",
          "type": "string"
        }
      },
      "required": ["risk_title", "description"],
      "title": "RiskFactor",
      "type": "object"
    },
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "segment_name": {
          "description": "Name of the segment.",
          "title": "Segment Name",
          "type": "string"
        },
        "description": {
          "description": "Description of the segment.",
          "title": "Description",
          "type": "string"
        }
      },
      "required": ["segment_name", "description"],
      "title": "Segment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "header": {
      "$ref": "#/$defs/Header",
      "description": "Header information of the 10-K filing."
    },
    "business_section": {
      "$ref": "#/$defs/BusinessSection",
      "description": "Business section of the 10-K filing."
    },
    "risk_factors": {
      "description": "Risk factors associated with the company's business.",
      "items": {
        "$ref": "#/$defs/RiskFactor"
      },
      "title": "Risk Factors",
      "type": "array"
    },
    "financial_statements": {
      "$ref": "#/$defs/FinancialStatements",
      "description": "Financial statements included in the 10-K filing."
    },
    "legal_proceedings": {
      "description": "Legal proceedings involving the company.",
      "items": {
        "$ref": "#/$defs/LegalProceeding"
      },
      "title": "Legal Proceedings",
      "type": "array"
    }
  },
  "required": [
    "header",
    "business_section",
    "risk_factors",
    "financial_statements",
    "legal_proceedings"
  ],
  "title": "Filing10K",
  "type": "object"
}
