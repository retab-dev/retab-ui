{
  "service": "retab-file-viewer",
  "version": "1.4.0",
  "features": {
    "pdf": true,
    "docx": true,
    "pptx": true,
    "xlsx": true,
    "images": [
      "png",
      "jpg",
      "webp",
      "tiff",
      "svg"
    ],
    "text": true,
    "markdown": true,
    "html": true
  },
  "limits": {
    "maxFileMB": 50,
    "virtualizeRowsOver": 200
  },
  "owners": [
    {
      "name": "Platform",
      "email": "platform@retab.com"
    },
    {
      "name": "Docs",
      "email": "docs@retab.com"
    }
  ]
}
