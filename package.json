{
  "name": "retab-ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Retab"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev --turbopack --port 4000",
    "build": "pnpm registry:build && next build",
    "start": "next start --port 4000",
    "preview": "next build && next start --port 4000",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint --fix . --cache --cache-location .eslintcache",
    "typecheck": "tsc --noEmit",
    "format:write": "prettier --write \"**/*.{ts,tsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,mdx}\" --cache",
    "registry:build": "shadcn build --output public/r",
    "registry:validate": "shadcn registry validate",
    "postinstall": "fumadocs-mdx",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@e965/xlsx": "0.20.3",
    "@hookform/resolvers": "^3.10.0",
    "@pierre/diffs": "^1.2.7",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@shikijs/themes": "3.14.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@vercel/analytics": "^2.0.1",
    "ajv": "^8.17.1",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "docx-preview": "^0.3.7",
    "dompurify": "3.4.9",
    "fumadocs-core": "16.0.5",
    "fumadocs-mdx": "13.0.2",
    "jotai": "^2.15.0",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "lru-cache": "^11.2.4",
    "lucide-react": "^0.460.0",
    "marked": "18.0.5",
    "next": "16.2.9",
    "next-themes": "0.4.6",
    "nuqs": "^2.8.9",
    "pdfjs-dist": "5.4.296",
    "pptxviewjs": "1.1.9",
    "prismjs": "^1.30.0",
    "radix-ui": "^1.5.0",
    "react": "19.2.3",
    "react-day-picker": "^9.4.4",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.54.0",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^4.11.2",
    "rehype-pretty-code": "^0.14.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "shiki": "^1.10.1",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.3.1",
    "utif": "3.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16",
    "@types/json-schema": "^7.0.15",
    "@types/lodash": "^4.17.13",
    "@types/node": "^20",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn": "^4.8.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8.59.1",
    "vitest": "^3.2.4"
  },
  "prettier": {
    "endOfLine": "lf",
    "semi": false,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "es5",
    "importOrder": [
      "^(react/(.*)$)|^(react$)",
      "^(next/(.*)$)|^(next$)",
      "<THIRD_PARTY_MODULES>",
      "",
      "^types$",
      "^@/types/(.*)$",
      "^@/config/(.*)$",
      "^@/lib/(.*)$",
      "^@/hooks/(.*)$",
      "^@/components/ui/(.*)$",
      "^@/components/(.*)$",
      "^@/registry/(.*)$",
      "^@/styles/(.*)$",
      "^@/app/(.*)$",
      "^@/www/(.*)$",
      "",
      "^[./]"
    ],
    "importOrderParserPlugins": [
      "typescript",
      "jsx",
      "decorators-legacy"
    ],
    "tailwindStylesheet": "./app/globals.css",
    "tailwindFunctions": [
      "cn",
      "cva"
    ],
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports",
      "prettier-plugin-tailwindcss"
    ]
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.2",
      "@shikijs/themes": "3.14.0",
      "@pierre/diffs": "1.2.7"
    }
  }
}
