{
  "$defs": {
    "BillTo": {
      "additionalProperties": false,
      "description": "Customer billing information including name and address for a trucking invoice.",
      "properties": {
        "name": {
          "description": "Name of the customer.",
          "title": "Name",
          "type": "string"
        },
        "address": {
          "description": "Address of the customer.",
          "title": "Address",
          "type": "string"
        }
      },
      "required": ["name", "address"],
      "title": "BillTo",
      "type": "object"
    },
    "CompanyInfo": {
      "additionalProperties": false,
      "description": "Company information with name and address details for a trucking invoice.",
      "properties": {
        "name": {
          "description": "Name of the company.",
          "title": "Name",
          "type": "string"
        },
        "address": {
          "description": "Address of the company.",
          "title": "Address",
          "type": "string"
        }
      },
      "required": ["name", "address"],
      "title": "CompanyInfo",
      "type": "object"
    },
    "InvoiceDetails": {
      "additionalProperties": false,
      "description": "Invoice details including invoice number, date, and due date for a trucking invoice.",
      "properties": {
        "invoice_number": {
          "description": "The invoice number.",
          "title": "Invoice Number",
          "type": "string"
        },
        "invoice_date": {
          "description": "The date the invoice was issued.",
          "title": "Invoice Date",
          "type": "string"
        },
        "due_date": {
          "description": "The date the payment is due.",
          "title": "Due Date",
          "type": "string"
        }
      },
      "required": ["invoice_number", "invoice_date", "due_date"],
      "title": "InvoiceDetails",
      "type": "object"
    },
    "InvoiceItem": {
      "additionalProperties": false,
      "description": "Individual line item on the trucking invoice with quantity, description, price and amount.",
      "properties": {
        "quantity": {
          "description": "Quantity of the item.",
          "title": "Quantity",
          "type": "number"
        },
        "description": {
          "description": "Description of the item.",
          "title": "Description",
          "type": "string"
        },
        "unit_price": {
          "description": "Unit price of the item.",
          "title": "Unit Price",
          "type": "number"
        },
        "amount": {
          "description": "Total amount for the item.",
          "title": "Amount",
          "type": "number"
        }
      },
      "required": ["quantity", "description", "unit_price", "amount"],
      "title": "InvoiceItem",
      "type": "object"
    },
    "Totals": {
      "additionalProperties": false,
      "description": "Total amounts for the trucking invoice including subtotal, sales tax, and final total.",
      "properties": {
        "subtotal": {
          "description": "Subtotal amount before tax.",
          "title": "Subtotal",
          "type": "number"
        },
        "sales_tax": {
          "description": "Sales tax amount.",
          "title": "Sales Tax",
          "type": "number"
        },
        "total": {
          "description": "Total amount including tax.",
          "title": "Total",
          "type": "number"
        }
      },
      "required": ["subtotal", "sales_tax", "total"],
      "title": "Totals",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete trucking invoice model with all information fields and system prompt configuration.",
  "properties": {
    "company_info": {
      "$ref": "#/$defs/CompanyInfo",
      "description": "Information about the company issuing the invoice."
    },
    "invoice_details": {
      "$ref": "#/$defs/InvoiceDetails",
      "description": "Details of the invoice including number and dates."
    },
    "bill_to": {
      "$ref": "#/$defs/BillTo",
      "description": "Information about the customer being billed."
    },
    "items": {
      "description": "List of items or services included in the invoice.",
      "items": {
        "$ref": "#/$defs/InvoiceItem"
      },
      "title": "Items",
      "type": "array"
    },
    "totals": {
      "$ref": "#/$defs/Totals",
      "description": "Financial totals for the invoice."
    },
    "terms": {
      "description": "Terms and conditions of the invoice.",
      "title": "Terms",
      "type": "string"
    }
  },
  "required": [
    "company_info",
    "invoice_details",
    "bill_to",
    "items",
    "totals",
    "terms"
  ],
  "title": "TruckingInvoice",
  "type": "object"
}
