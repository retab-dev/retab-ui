{
  "$defs": {
    "Charges": {
      "properties": {
        "weight_charge": {
          "description": "Weight charge for the entire consignment",
          "title": "Weight Charge",
          "type": "number"
        },
        "valuation_charge": {
          "description": "Valuation charge to cover declared value",
          "title": "Valuation Charge",
          "type": "number"
        },
        "tax": {
          "description": "Tax imposed on the shipment",
          "title": "Tax",
          "type": "number"
        },
        "other_charges_due_agent": {
          "description": "Additional charges due to the agent",
          "title": "Other Charges Due Agent",
          "type": "number"
        },
        "other_charges_due_carrier": {
          "description": "Additional charges due to the carrier",
          "title": "Other Charges Due Carrier",
          "type": "number"
        },
        "total_prepaid": {
          "description": "Total amount prepaid",
          "title": "Total Prepaid",
          "type": "number"
        },
        "total_collect": {
          "description": "Total amount to collect",
          "title": "Total Collect",
          "type": "number"
        },
        "currency": {
          "description": "Currency used for these charges",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "weight_charge",
        "valuation_charge",
        "tax",
        "other_charges_due_agent",
        "other_charges_due_carrier",
        "total_prepaid",
        "total_collect",
        "currency"
      ],
      "title": "Charges",
      "type": "object"
    },
    "Consignee": {
      "properties": {
        "name": {
          "description": "Consignee's full name",
          "title": "Name",
          "type": "string"
        },
        "address": {
          "description": "Consignee's street address or general location details",
          "title": "Address",
          "type": "string"
        },
        "city": {
          "description": "City of the consignee",
          "title": "City",
          "type": "string"
        },
        "country": {
          "description": "Country of the consignee",
          "title": "Country",
          "type": "string"
        },
        "phone": {
          "description": "Phone number of the consignee",
          "title": "Phone",
          "type": "string"
        },
        "account_number": {
          "description": "Account number of the consignee",
          "title": "Account Number",
          "type": "string"
        }
      },
      "required": [
        "name",
        "address",
        "city",
        "country",
        "phone",
        "account_number"
      ],
      "title": "Consignee",
      "type": "object"
    },
    "ExecutionDetails": {
      "properties": {
        "date": {
          "description": "Date of execution",
          "title": "Date",
          "type": "string"
        },
        "place": {
          "description": "Place of execution",
          "title": "Place",
          "type": "string"
        },
        "signature_of_issuing_carrier": {
          "description": "Signature of the issuing carrier or its agent",
          "title": "Signature Of Issuing Carrier",
          "type": "string"
        },
        "signature_of_shipper": {
          "description": "Signature of the shipper or shipper's agent",
          "title": "Signature Of Shipper",
          "type": "string"
        }
      },
      "required": [
        "date",
        "place",
        "signature_of_issuing_carrier",
        "signature_of_shipper"
      ],
      "title": "ExecutionDetails",
      "type": "object"
    },
    "FlightInfo": {
      "properties": {
        "airport_of_departure": {
          "description": "Name or code of the departure airport",
          "title": "Airport Of Departure",
          "type": "string"
        },
        "airport_of_destination": {
          "description": "Name or code of the destination airport",
          "title": "Airport Of Destination",
          "type": "string"
        },
        "flight_numbers": {
          "description": "List of flight numbers associated with shipment",
          "items": {
            "type": "string"
          },
          "title": "Flight Numbers",
          "type": "array"
        },
        "requested_flight_date": {
          "description": "Requested date for flight(s)",
          "title": "Requested Flight Date",
          "type": "string"
        }
      },
      "required": [
        "airport_of_departure",
        "airport_of_destination",
        "flight_numbers",
        "requested_flight_date"
      ],
      "title": "FlightInfo",
      "type": "object"
    },
    "ShipmentDetail": {
      "properties": {
        "pieces": {
          "description": "Number of pieces in this line item",
          "title": "Pieces",
          "type": "number"
        },
        "gross_weight": {
          "description": "Gross weight for this line item",
          "title": "Gross Weight",
          "type": "number"
        },
        "commodity_item_no": {
          "description": "Commodity item number or code",
          "title": "Commodity Item No",
          "type": "string"
        },
        "chargeable_weight": {
          "description": "Chargeable weight for this line item",
          "title": "Chargeable Weight",
          "type": "number"
        },
        "rate_class": {
          "description": "Rate class code, e.g. 'K', 'S', etc.",
          "title": "Rate Class",
          "type": "string"
        },
        "rate_or_charge": {
          "description": "Rate or charge applied per unit",
          "title": "Rate Or Charge",
          "type": "number"
        },
        "total": {
          "description": "Total charge for this line item",
          "title": "Total",
          "type": "number"
        },
        "nature_quantity_of_goods": {
          "description": "Description of goods including nature and quantity",
          "title": "Nature Quantity Of Goods",
          "type": "string"
        },
        "dimensions": {
          "description": "Dimensions of the goods in this line item",
          "title": "Dimensions",
          "type": "string"
        },
        "volume": {
          "description": "Volume of the goods in this line item",
          "title": "Volume",
          "type": "string"
        }
      },
      "required": [
        "pieces",
        "gross_weight",
        "commodity_item_no",
        "chargeable_weight",
        "rate_class",
        "rate_or_charge",
        "total",
        "nature_quantity_of_goods",
        "dimensions",
        "volume"
      ],
      "title": "ShipmentDetail",
      "type": "object"
    },
    "Shipper": {
      "properties": {
        "name": {
          "description": "Shipper's full name",
          "title": "Name",
          "type": "string"
        },
        "address": {
          "description": "Shipper's street address or general location details",
          "title": "Address",
          "type": "string"
        },
        "city": {
          "description": "City of the shipper",
          "title": "City",
          "type": "string"
        },
        "country": {
          "description": "Country of the shipper",
          "title": "Country",
          "type": "string"
        },
        "phone": {
          "description": "Phone number of the shipper",
          "title": "Phone",
          "type": "string"
        },
        "account_number": {
          "description": "Account number of the shipper",
          "title": "Account Number",
          "type": "string"
        }
      },
      "required": [
        "name",
        "address",
        "city",
        "country",
        "phone",
        "account_number"
      ],
      "title": "Shipper",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "shipper": {
      "$ref": "#/$defs/Shipper",
      "description": "Information about the shipper"
    },
    "consignee": {
      "$ref": "#/$defs/Consignee",
      "description": "Information about the consignee"
    },
    "air_waybill_number": {
      "description": "Unique air waybill or reference number",
      "title": "Air Waybill Number",
      "type": "string"
    },
    "issuing_carrier": {
      "description": "Name of the issuing carrier",
      "title": "Issuing Carrier",
      "type": "string"
    },
    "agent_iata_code": {
      "description": "IATA code of the agent issuing the air waybill",
      "title": "Agent Iata Code",
      "type": "string"
    },
    "account_no": {
      "description": "Account number used on the air waybill",
      "title": "Account No",
      "type": "string"
    },
    "flight_info": {
      "$ref": "#/$defs/FlightInfo",
      "description": "Details about the flight, origin, and destination"
    },
    "shipment_details": {
      "description": "Line items in the shipment detailing pieces, weight, rate, etc.",
      "items": {
        "$ref": "#/$defs/ShipmentDetail"
      },
      "title": "Shipment Details",
      "type": "array"
    },
    "charges": {
      "$ref": "#/$defs/Charges",
      "description": "Breakdown of the charges for the shipment"
    },
    "handling_information": {
      "description": "Special handling information for the shipment",
      "title": "Handling Information",
      "type": "string"
    },
    "disclaimers": {
      "description": "Important disclaimers or notes displayed on the air waybill",
      "items": {
        "type": "string"
      },
      "title": "Disclaimers",
      "type": "array"
    },
    "execution_details": {
      "$ref": "#/$defs/ExecutionDetails",
      "description": "Execution details such as date, place, and signatures"
    }
  },
  "required": [
    "shipper",
    "consignee",
    "air_waybill_number",
    "issuing_carrier",
    "agent_iata_code",
    "account_no",
    "flight_info",
    "shipment_details",
    "charges",
    "handling_information",
    "disclaimers",
    "execution_details"
  ],
  "title": "AirWaybill",
  "type": "object"
}
