{
  "$defs": {
    "Assets": {
      "additionalProperties": false,
      "properties": {
        "current_assets": {
          "description": "Total current assets.",
          "title": "Current Assets",
          "type": "number"
        },
        "non_current_assets": {
          "description": "Total non-current assets.",
          "title": "Non Current Assets",
          "type": "number"
        },
        "total_assets": {
          "description": "Total assets.",
          "title": "Total Assets",
          "type": "number"
        }
      },
      "required": ["current_assets", "non_current_assets", "total_assets"],
      "title": "Assets",
      "type": "object"
    },
    "BalanceSheet": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "$ref": "#/$defs/Assets",
          "description": "Total current assets, non-current assets, and total assets."
        },
        "liabilities_and_equity": {
          "$ref": "#/$defs/LiabilitiesAndEquity",
          "description": "Total current liabilities, non-current liabilities, total liabilities, shareholders' equity, and total liabilities and equity."
        }
      },
      "required": ["assets", "liabilities_and_equity"],
      "title": "BalanceSheet",
      "type": "object"
    },
    "CompanyInfo": {
      "additionalProperties": false,
      "properties": {
        "company_name": {
          "description": "The name of the company.",
          "title": "Company Name",
          "type": "string"
        },
        "state_of_incorporation": {
          "description": "The state or jurisdiction of incorporation.",
          "title": "State Of Incorporation",
          "type": "string"
        },
        "irs_employer_id": {
          "description": "The IRS Employer Identification Number.",
          "title": "Irs Employer Id",
          "type": "string"
        },
        "address": {
          "description": "The principal executive office address.",
          "title": "Address",
          "type": "string"
        },
        "zip_code": {
          "description": "The zip code of the principal executive office.",
          "title": "Zip Code",
          "type": "string"
        },
        "phone_number": {
          "description": "The registrant's telephone number.",
          "title": "Phone Number",
          "type": "string"
        }
      },
      "required": [
        "company_name",
        "state_of_incorporation",
        "irs_employer_id",
        "address",
        "zip_code",
        "phone_number"
      ],
      "title": "CompanyInfo",
      "type": "object"
    },
    "CostOfSales": {
      "additionalProperties": false,
      "properties": {
        "products": {
          "description": "Cost of sales for products.",
          "title": "Products",
          "type": "number"
        },
        "services": {
          "description": "Cost of sales for services.",
          "title": "Services",
          "type": "number"
        },
        "total": {
          "description": "Total cost of sales.",
          "title": "Total",
          "type": "number"
        }
      },
      "required": ["products", "services", "total"],
      "title": "CostOfSales",
      "type": "object"
    },
    "FinancialStatements": {
      "additionalProperties": false,
      "properties": {
        "income_statement": {
          "$ref": "#/$defs/IncomeStatement",
          "description": "Condensed consolidated statements of operations."
        },
        "balance_sheet": {
          "$ref": "#/$defs/BalanceSheet",
          "description": "Condensed consolidated balance sheets."
        }
      },
      "required": ["income_statement", "balance_sheet"],
      "title": "FinancialStatements",
      "type": "object"
    },
    "IncomeStatement": {
      "additionalProperties": false,
      "properties": {
        "net_sales": {
          "$ref": "#/$defs/NetSales",
          "description": "Net sales figures for products, services, and the total."
        },
        "cost_of_sales": {
          "$ref": "#/$defs/CostOfSales",
          "description": "Cost of sales for products, services, and the total."
        },
        "gross_margin": {
          "description": "Gross margin.",
          "title": "Gross Margin",
          "type": "number"
        },
        "operating_expenses": {
          "$ref": "#/$defs/OperatingExpenses",
          "description": "Expenses for research and development, selling, general and administrative, and the total."
        },
        "operating_income": {
          "description": "Operating income.",
          "title": "Operating Income",
          "type": "number"
        },
        "net_income": {
          "description": "Net income.",
          "title": "Net Income",
          "type": "number"
        }
      },
      "required": [
        "net_sales",
        "cost_of_sales",
        "gross_margin",
        "operating_expenses",
        "operating_income",
        "net_income"
      ],
      "title": "IncomeStatement",
      "type": "object"
    },
    "LegalProceeding": {
      "additionalProperties": false,
      "properties": {
        "case_name": {
          "description": "The name of the legal case.",
          "title": "Case Name",
          "type": "string"
        },
        "description": {
          "description": "Description of the legal proceeding.",
          "title": "Description",
          "type": "string"
        }
      },
      "required": ["case_name", "description"],
      "title": "LegalProceeding",
      "type": "object"
    },
    "LiabilitiesAndEquity": {
      "additionalProperties": false,
      "properties": {
        "current_liabilities": {
          "description": "Total current liabilities.",
          "title": "Current Liabilities",
          "type": "number"
        },
        "non_current_liabilities": {
          "description": "Total non-current liabilities.",
          "title": "Non Current Liabilities",
          "type": "number"
        },
        "total_liabilities": {
          "description": "Total liabilities.",
          "title": "Total Liabilities",
          "type": "number"
        },
        "shareholders_equity": {
          "description": "Total shareholders' equity.",
          "title": "Shareholders Equity",
          "type": "number"
        },
        "total_liabilities_and_equity": {
          "description": "Total liabilities and shareholders' equity.",
          "title": "Total Liabilities And Equity",
          "type": "number"
        }
      },
      "required": [
        "current_liabilities",
        "non_current_liabilities",
        "total_liabilities",
        "shareholders_equity",
        "total_liabilities_and_equity"
      ],
      "title": "LiabilitiesAndEquity",
      "type": "object"
    },
    "NetSales": {
      "additionalProperties": false,
      "properties": {
        "products": {
          "description": "Net sales from products.",
          "title": "Products",
          "type": "number"
        },
        "services": {
          "description": "Net sales from services.",
          "title": "Services",
          "type": "number"
        },
        "total": {
          "description": "Total net sales.",
          "title": "Total",
          "type": "number"
        }
      },
      "required": ["products", "services", "total"],
      "title": "NetSales",
      "type": "object"
    },
    "OperatingExpenses": {
      "additionalProperties": false,
      "properties": {
        "research_and_development": {
          "description": "Research and development expenses.",
          "title": "Research And Development",
          "type": "number"
        },
        "selling_general_and_administrative": {
          "description": "Selling, general and administrative expenses.",
          "title": "Selling General And Administrative",
          "type": "number"
        },
        "total": {
          "description": "Total operating expenses.",
          "title": "Total",
          "type": "number"
        }
      },
      "required": [
        "research_and_development",
        "selling_general_and_administrative",
        "total"
      ],
      "title": "OperatingExpenses",
      "type": "object"
    },
    "ReportInfo": {
      "additionalProperties": false,
      "properties": {
        "period_end_date": {
          "description": "The end date of the quarterly period.",
          "title": "Period End Date",
          "type": "string"
        },
        "commission_file_number": {
          "description": "The SEC commission file number.",
          "title": "Commission File Number",
          "type": "string"
        },
        "shares_outstanding": {
          "description": "Number of shares outstanding as of a specific date.",
          "title": "Shares Outstanding",
          "type": "number"
        },
        "shares_outstanding_date": {
          "description": "The date as of which the shares outstanding is reported.",
          "title": "Shares Outstanding Date",
          "type": "string"
        }
      },
      "required": [
        "period_end_date",
        "commission_file_number",
        "shares_outstanding",
        "shares_outstanding_date"
      ],
      "title": "ReportInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "company_info": {
      "$ref": "#/$defs/CompanyInfo",
      "description": "Information about the company filing the 10-Q."
    },
    "report_info": {
      "$ref": "#/$defs/ReportInfo",
      "description": "Details about the 10-Q report."
    },
    "financial_statements": {
      "$ref": "#/$defs/FinancialStatements",
      "description": "Financial statements included in the 10-Q."
    },
    "legal_proceedings": {
      "description": "Legal proceedings mentioned in the 10-Q.",
      "items": {
        "$ref": "#/$defs/LegalProceeding"
      },
      "title": "Legal Proceedings",
      "type": "array"
    }
  },
  "required": [
    "company_info",
    "report_info",
    "financial_statements",
    "legal_proceedings"
  ],
  "title": "Filing10Q",
  "type": "object"
}
