{
  "$defs": {
    "CompanyInformation": {
      "properties": {
        "company_name": {
          "description": "Legal name of the company.",
          "title": "Company Name",
          "type": "string"
        },
        "business_address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Registered business address of the company.",
          "title": "Business Address"
        },
        "incorporation_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Date of incorporation.",
          "title": "Incorporation Date"
        },
        "incorporation_jurisdiction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Jurisdiction where the company is incorporated.",
          "title": "Incorporation Jurisdiction"
        }
      },
      "required": [
        "company_name",
        "business_address",
        "incorporation_date",
        "incorporation_jurisdiction"
      ],
      "title": "CompanyInformation",
      "type": "object"
    },
    "FinancialMetrics": {
      "properties": {
        "revenue": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Total revenue reported.",
          "title": "Revenue"
        },
        "net_income_loss": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Net income or loss reported.",
          "title": "Net Income Loss"
        },
        "total_assets": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Total assets reported.",
          "title": "Total Assets"
        },
        "total_liabilities": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Total liabilities reported.",
          "title": "Total Liabilities"
        },
        "total_equity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Total shareholders' equity reported.",
          "title": "Total Equity"
        }
      },
      "required": [
        "revenue",
        "net_income_loss",
        "total_assets",
        "total_liabilities",
        "total_equity"
      ],
      "title": "FinancialMetrics",
      "type": "object"
    },
    "ManagementMember": {
      "properties": {
        "name": {
          "description": "Name of the executive or board member.",
          "title": "Name",
          "type": "string"
        },
        "title": {
          "description": "Title or role within the company.",
          "title": "Title",
          "type": "string"
        },
        "compensation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Compensation details, if available.",
          "title": "Compensation"
        }
      },
      "required": [
        "name",
        "title",
        "compensation"
      ],
      "title": "ManagementMember",
      "type": "object"
    },
    "OfferingDetails": {
      "properties": {
        "shares_offered": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Total number of shares offered.",
          "title": "Shares Offered"
        },
        "proposed_ticker_symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Proposed stock ticker symbol.",
          "title": "Proposed Ticker Symbol"
        },
        "price_range": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Proposed initial price range per share.",
          "title": "Price Range"
        },
        "underwriters": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "List of underwriters involved in the offering.",
          "title": "Underwriters"
        }
      },
      "required": [
        "shares_offered",
        "proposed_ticker_symbol",
        "price_range",
        "underwriters"
      ],
      "title": "OfferingDetails",
      "type": "object"
    },
    "Shareholder": {
      "properties": {
        "name": {
          "description": "Name of the shareholder.",
          "title": "Name",
          "type": "string"
        },
        "ownership_percentage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Percentage of shares owned by the shareholder.",
          "title": "Ownership Percentage"
        }
      },
      "required": [
        "name",
        "ownership_percentage"
      ],
      "title": "Shareholder",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "company_information": {
      "$ref": "#/$defs/CompanyInformation"
    },
    "offering_details": {
      "$ref": "#/$defs/OfferingDetails"
    },
    "financial_information": {
      "$ref": "#/$defs/FinancialMetrics"
    },
    "risk_factors": {
      "description": "List of summarized major risk factors.",
      "items": {
        "type": "string"
      },
      "title": "Risk Factors",
      "type": "array"
    },
    "management_information": {
      "items": {
        "$ref": "#/$defs/ManagementMember"
      },
      "title": "Management Information",
      "type": "array"
    },
    "use_of_proceeds": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Description of planned usage of the funds raised from IPO.",
      "title": "Use Of Proceeds"
    },
    "major_shareholders": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Shareholder"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Major Shareholders"
    },
    "extraction_notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Additional notes regarding uncertainties, discrepancies, or missing information encountered during extraction.",
      "title": "Extraction Notes"
    }
  },
  "required": [
    "company_information",
    "offering_details",
    "financial_information",
    "risk_factors",
    "management_information",
    "use_of_proceeds",
    "major_shareholders",
    "extraction_notes"
  ],
  "title": "S1Filing",
  "type": "object"
}
